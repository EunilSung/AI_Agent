<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 앱이 지원하는 언어. Compose 리소스(values, values-ko)와 같게 맞춘다. 없으면 iOS 는 영어만 지원한다고 본다. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ko</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Talk 의 파일 대화 "AI 요약"이 aiagent://summarize?fileId=…&fileName=…&userId=…&userName=… 로 이 앱을 연다. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.eunilsung.aiagent.summarize</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aiagent</string>
			</array>
		</dict>
	</array>
	<!--
		ATS 를 통째로 끄지 않고 로컬 평문만 연다 — 시뮬레이터는 이 Mac 의 브릿지(http://localhost:8095)에 붙는다.
		NSAllowsLocalNetworking 은 localhost 말고도 .local 이름·점 없는 이름(IP 주소도 그렇다고 알려져 있다)의 평문을 연다.
		그래서 iOS 는 OS 가 아니라 앱의 주소 규칙(domain/util/BridgeAddress.kt)이 막는다 — 설정·로그인 화면 입력, 저장된 주소,
		빌드 기본 주소(bridge.baseUrl)가 모두 그 규칙을 거친다. 실기기·터널은 https 주소를 쓴다.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>같은 네트워크의 AI 브릿지 서버에 연결합니다.</string>
</dict>
</plist>
